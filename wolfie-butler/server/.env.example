# Copy to .env and fill in. Never commit .env or put these keys in index.html.
PORT=8787
# Comma-separated list of sites allowed to call this server (your static site's URL).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5500
SERVICE_DATE=2026-10-23

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# Any voice ID from your ElevenLabs voice library
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2

# Photon Spectrum, hosted iMessage (https://app.photon.codes)
PROJECT_ID=
PROJECT_SECRET=

# Medal clip previews through Embedly oEmbed (optional, https://embed.ly)
EMBEDLY_KEY=
